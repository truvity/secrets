  "definitions": {
    "namespaceSelector": {
      "description": "A selector that selects: {} (and empty matchLabels with empty matchExpressions) matches every namespace, so it is refused.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": {
          "$ref": "#/definitions/stringMap"
        },
        "matchExpressions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "matchLabels"
          ],
          "properties": {
            "matchLabels": {
              "minProperties": 1
            }
          }
        },
        {
          "required": [
            "matchExpressions"
          ],
          "properties": {
            "matchExpressions": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "namespaceNames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "storeCondition": {
      "description": "One ClusterSecretStore condition that selects something. A regex must be anchored (^...$), and one that matches every namespace is refused, at render time.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "namespaces": {
          "$ref": "#/definitions/namespaceNames"
        },
        "namespaceSelector": {
          "$ref": "#/definitions/namespaceSelector"
        },
        "namespaceRegexes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "awsStoreCondition": {
