        }
      }
    },
    "awsNamespaceSelector": {
      "description": "Labels, or expressions that each name the values a label must have (operator In): a NotIn, Exists or DoesNotExist selects namespaces nobody listed.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": {
          "$ref": "#/definitions/stringMap"
        },
        "matchExpressions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "operator",
              "values"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "type": "string",
                "enum": [
                  "In"
                ]
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "matchLabels"
          ],
          "properties": {
            "matchLabels": {
              "minProperties": 1
            }
          }
        },
        {
          "required": [
            "matchExpressions"
          ],
          "properties": {
            "matchExpressions": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "allowedValues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values"],
      "properties": {
        "values": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "required": {"type": "boolean"}
      }
    },
    "extraConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minDuration": {"type": "string", "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)([0-9]+(ns|us|µs|ms|s|m|h))*$"},
        "maxDuration": {"type": "string", "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)([0-9]+(ns|us|µs|ms|s|m|h))*$"},
        "privateKey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "algorithm": {"type": "string", "enum": ["RSA", "ECDSA", "Ed25519"]},
            "minSize": {"type": "integer", "minimum": 1},
            "maxSize": {"type": "integer", "minimum": 1}
          }
        }
      }
