{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "openbao-consumers values",
  "description": "An unknown key is an error, not a silent no-op: a typo in a store's values would otherwise render a store that quietly reads somewhere else.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "commonAnnotations": {
      "$ref": "#/definitions/stringMap"
    },
    "server": {
      "type": "string"
    },
    "caBundle": {
      "type": "string"
    },
    "vaultNamespace": {
      "type": "string"
    },
    "kvMount": {
      "type": "string",
      "minLength": 1
    },
    "storeSuffix": {
      "type": "string",
      "minLength": 1
    },
    "writerAuthMount": {
      "type": "string"
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mountPath": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "expirationSeconds": {
          "type": "integer",
          "minimum": 600,
          "maximum": 86400
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "stores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string"
          },
          "vaultNamespace": {
            "type": "string"
          },
          "annotations": {
            "$ref": "#/definitions/stringMap"
          },
          "conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/storeCondition"
            }
          }
        }
      }
    },
    "writers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "namespace": {
            "type": "string"
          },
          "serviceAccount": {
            "type": "string"
          },
          "environments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "annotations": {
            "$ref": "#/definitions/stringMap"
          }
        }
      }
    },
    "aws": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "description": "Required with awsStores: how External Secrets on this cluster proves who it is to AWS. One mode per cluster; no default.",
          "type": "string",
          "enum": [
            "",
            "podIdentity",
            "webIdentity"
          ]
        },
        "webIdentity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "audience": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "admissionPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "name": {
              "type": "string"
            },
            "labels": {
              "$ref": "#/definitions/stringMap"
            },
            "annotations": {
              "$ref": "#/definitions/stringMap"
            },
            "validationActions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "Deny",
                  "Warn",
                  "Audit"
                ]
              }
            },
            "failurePolicy": {
              "type": "string",
              "enum": [
                "Fail",
                "Ignore"
              ]
            },
            "acknowledgeTenantsCanBorrowControllerIdentity": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "awsStores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "region",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "pattern": "^[a-z]{2,}(-[a-z0-9]+)+$"
          },
          "role": {
            "description": "The grant's reader role, in the parameters' account: one IAM role ARN, no wildcard.",
            "type": "string",
            "pattern": "^arn:aws(-[a-z]+)*:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$"
          },
          "auth": {
            "description": "webIdentity only, and required there: the one auth shape this chart renders.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "jwt"
            ],
            "properties": {
              "jwt": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "serviceAccountRef"
                ],
                "properties": {
                  "serviceAccountRef": {
                    "description": "Both required: a ClusterSecretStore's ref without a namespace resolves in the namespace of each ExternalSecret that uses it.",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "namespace"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"
                      },
                      "namespace": {
                        "type": "string",
                        "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
                      }
                    }
                  }
                }
              }
            }
          },
          "serviceAccount": {
            "description": "webIdentity only: whether this chart renders the ServiceAccount auth.jwt.serviceAccountRef names.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "create": {
                "type": "boolean"
              },
              "annotations": {
                "$ref": "#/definitions/stringMap"
              }
            }
          },
          "annotations": {
            "$ref": "#/definitions/stringMap"
          },
          "conditions": {
            "description": "No namespaceRegexes: an AWS store names its namespaces, or selects them by label.",
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/awsStoreCondition"
            }
          }
        }
      }
    },
    "awsWriters": {
      "description": "Writer stores on Parameter Store (podIdentity only): one ClusterSecretStore each, assuming a writer role and pinned to one parameter prefix. The narrow exception to reader-only stores.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "region", "role", "prefix", "conditions"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "region": { "type": "string", "pattern": "^[a-z]{2,}(-[a-z0-9]+)+$" },
          "role": {
            "description": "The writer role in the parameters' account: one IAM role ARN, no wildcard.",
            "type": "string",
            "pattern": "^arn:aws(-[a-z]+)*:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$"
          },
          "prefix": {
            "description": "The one parameter path the store reads and writes: starts and ends with \"/\", no wildcard, at least one segment. A PushSecret's remoteKey is appended to it.",
            "type": "string",
            "pattern": "^/[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*/$"
          },
          "annotations": { "$ref": "#/definitions/stringMap" },
          "conditions": {
            "description": "Exactly one entry naming the namespaces (no selector, no regex) that may use the store.",
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["namespaces"],
              "properties": { "namespaces": { "$ref": "#/definitions/namespaceNames" } }
            }
          }
        }
      }
    },
    "pki": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "certManager": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "serviceAccountName": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "issuerServiceAccount": {
          "type": "string",
          "minLength": 1
        },
        "vaultNamespace": {
          "type": "string"
        },
        "authMountPath": {
          "type": "string"
        },
        "trustAnchors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "certificate"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "certificate": {
                "type": "string",
                "minLength": 1,
                "description": "base64 PEM"
              },
              "labels": {
                "$ref": "#/definitions/stringMap"
              },
              "annotations": {
                "$ref": "#/definitions/stringMap"
              }
            }
          }
        },
        "rootKey": {
          "type": "string",
          "minLength": 1
        },
        "issuers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "signPath",
              "role"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "ClusterIssuer",
                  "Issuer"
                ]
              },
              "signPath": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "audiences": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "vaultNamespace": {
                "type": "string"
              },
              "annotations": {
                "$ref": "#/definitions/stringMap"
              },
              "identity": {
                "type": "boolean",
                "description": "Marks the SPIFFE identity issuer (the one csi-driver-spiffe requests from). The issuer is rendered like any other, but approverPolicy never renders a policy for it and refuses to be pointed at it: csi-driver-spiffe's own approver owns that signer."
              }
            }
          }
        },
        "bundle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "annotations": {
              "$ref": "#/definitions/stringMap"
            },
            "extraSources": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "namespaceSelector": {
                  "type": "object"
                }
              }
            }
          }
        },
        "bundles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sources", "target"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "annotations": { "$ref": "#/definitions/stringMap" },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["inLine"],
                  "properties": {
                    "inLine": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "namespaceSelector"],
                "properties": {
                  "key": { "type": "string", "minLength": 1 },
                  "namespaceSelector": { "type": "object" }
                }
              }
            }
          }
        }
      }
    },
    "certificateDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration": {
          "type": "string"
        },
        "renewBefore": {
          "type": "string"
        },
        "privateKey": {
          "type": "object"
        }
      }
    },
    "certificates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "namespace": {
            "type": "string"
          },
          "secretName": {
            "type": "string"
          },
          "commonName": {
            "type": "string"
          },
          "dnsNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uris": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "usages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duration": {
            "type": "string"
          },
          "renewBefore": {
            "type": "string"
          },
          "privateKey": {
            "type": "object"
          },
          "issuerRef": {
            "type": "object"
          },
          "annotations": {
            "$ref": "#/definitions/stringMap"
          },
          "labels": {
            "$ref": "#/definitions/stringMap"
          }
        }
      }
    },
    "approverPolicy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional cert-manager approver-policy layer for the issuers this chart creates. Off by default: enabling it renders CertificateRequestPolicy objects and the RBAC that lets cert-manager use them, and is only safe once approver-policy is installed.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "roleName": {
          "type": "string"
        },
        "requesters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "name"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "ServiceAccount",
                  "User",
                  "Group"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string"
              },
              "apiGroup": {
                "type": "string"
              }
            }
          }
        },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minDuration": {
              "type": "string",
              "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)([0-9]+(ns|us|µs|ms|s|m|h))*$"
            },
            "maxDuration": {
              "type": "string",
              "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)([0-9]+(ns|us|µs|ms|s|m|h))*$"
            },
            "privateKey": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "algorithm": {
                  "type": "string",
                  "enum": [
                    "RSA",
                    "ECDSA",
                    "Ed25519"
                  ]
                },
                "minSize": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxSize": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "issuers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/approverConstraints"
          }
        },
        "namespacedIssuers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "extraPolicies": {
          "type": "array",
          "description": "CertificateRequestPolicy objects for issuers outside pki.issuers, written out as given.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "issuerRef", "allowed"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "issuerRef": {
                "type": "object",
                "additionalProperties": false,
                "required": ["group", "kind", "name"],
                "properties": {
                  "group": {"type": "string", "minLength": 1},
                  "kind": {"type": "string", "minLength": 1},
                  "name": {"type": "string", "minLength": 1}
                }
              },
              "selector": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "namespace": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "matchNames": {"type": "array", "items": {"type": "string", "minLength": 1}},
                      "matchLabels": {"$ref": "#/definitions/stringMap"}
                    }
                  }
                }
              },
              "allowed": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "commonName": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["value"],
                    "properties": {"value": {"type": "string"}, "required": {"type": "boolean"}}
                  },
                  "dnsNames": {"$ref": "#/definitions/allowedValues"},
                  "uris": {"$ref": "#/definitions/allowedValues"},
                  "ipAddresses": {"$ref": "#/definitions/allowedValues"},
                  "emailAddresses": {"$ref": "#/definitions/allowedValues"},
                  "isCA": {"type": "boolean"},
                  "usages": {"type": "array", "items": {"type": "string", "minLength": 1}}
                }
              },
              "constraints": {"$ref": "#/definitions/extraConstraints"},
              "syncWave": {"type": "integer"},
              "annotations": {"$ref": "#/definitions/stringMap"},
              "roleName": {"type": "string"}
            }
          }
        }
      }
    },
    "admissionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "description": "The ValidatingAdmissionPolicy for namespaces at mTLS level enforced. Off by default.",
      "properties": {
        "enabled": {"type": "boolean"},
        "name": {"type": "string"},
        "labels": {"$ref": "#/definitions/stringMap"},
        "annotations": {"$ref": "#/definitions/stringMap"},
        "namespaceLabel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {"type": "string", "minLength": 1},
            "value": {"type": "string", "minLength": 1}
          }
        },
        "validationActions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["Deny", "Warn", "Audit"]}
        },
        "failurePolicy": {"type": "string", "enum": ["Fail", "Ignore"]},
        "workloads": {"type": "boolean"},
        "exemptAnnotation": {"type": "string", "minLength": 1},
        "csi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "driver": {"type": "string", "minLength": 1},
            "ignoreContainers": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"}
          }
        },
        "services": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "tlsAppProtocols": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "allow": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "gatewayFrontedAnnotation": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "alerts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Issuance-chain alerts. Off by default; the format is a value.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "format": {
          "type": "string",
          "enum": [
            "vmrule",
            "prometheusrule",
            "configmap"
          ]
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "labels": {
          "$ref": "#/definitions/stringMap"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "ruleLabels": {
          "$ref": "#/definitions/stringMap"
        },
        "groupName": {
          "type": "string",
          "minLength": 1
        },
        "interval": {
          "type": "string",
          "pattern": "^([0-9]+(ms|s|m|h|d|w|y))*$"
        },
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceRegex": {
              "type": "string"
            },
            "nameRegex": {
              "type": "string"
            }
          }
        },
        "workloadNamespace": {
          "type": "string"
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "certificateNotReady": {
              "type": "object",
              "additionalProperties": false,
              "description": "A Certificate that is not Ready for `for`.",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "for": {
                  "type": "string",
                  "pattern": "^[0-9]+(ms|s|m|h|d|w|y)([0-9]+(ms|s|m|h|d|w|y))*$"
                },
                "severity": {
                  "type": "string",
                  "minLength": 1
                },
                "labels": {
                  "$ref": "#/definitions/stringMap"
                },
                "annotations": {
                  "$ref": "#/definitions/stringMap"
                }
              }
            },
            "certificateRequestDenied": {
              "type": "object",
              "additionalProperties": false,
              "description": "Opt-in: a denied CertificateRequest, from a kube-state-metrics custom resource state metric.",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "for": {
                  "type": "string",
                  "pattern": "^[0-9]+(ms|s|m|h|d|w|y)([0-9]+(ms|s|m|h|d|w|y))*$"
                },
                "severity": {
                  "type": "string",
                  "minLength": 1
                },
                "labels": {
                  "$ref": "#/definitions/stringMap"
                },
                "annotations": {
                  "$ref": "#/definitions/stringMap"
                },
                "metric": {
                  "type": "string",
                  "minLength": 1
                },
                "typeLabel": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "csiDriverSpiffeUnavailable": {
              "type": "object",
              "additionalProperties": false,
              "description": "csi-driver-spiffe driver or approver pods unavailable.",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "for": {
                  "type": "string",
                  "pattern": "^[0-9]+(ms|s|m|h|d|w|y)([0-9]+(ms|s|m|h|d|w|y))*$"
                },
                "severity": {
                  "type": "string",
                  "minLength": 1
                },
                "labels": {
                  "$ref": "#/definitions/stringMap"
                },
                "annotations": {
                  "$ref": "#/definitions/stringMap"
                },
                "daemonSetRegex": {
                  "type": "string"
                },
                "deploymentRegex": {
